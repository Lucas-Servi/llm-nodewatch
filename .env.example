# ── nodewatch configuration ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Every variable below is optional — nodewatch works with none of them set,
# writing to ./nodewatch.db. Full reference: docs/env.md

# ── Local settings ───────────────────────────────────────────────────────────
# Path to the local SQLite database (default: nodewatch.db in the cwd)
# NODEWATCH_DB=nodewatch.db

# Path to a custom pricing JSON (default: the table bundled in the package)
# NODEWATCH_PRICING=/path/to/custom/pricing.json

# Base directory for A/B testing sessions (default: ./testing_sessions)
# NODEWATCH_SESSIONS_DIR=./testing_sessions

# Log file tailed by the dashboard's Logs tab and the get_logs API method
# NODEWATCH_LOG_PATH=/var/log/my-agent.log

# ── Remote API (optional) ────────────────────────────────────────────────────
# If set, the CLI and dashboard read from a remote server instead of local
# SQLite. Pass --local / -L to override for a single invocation.
# NODEWATCH_URL=https://your-server.com/api/path

# Include raw remote response bodies in error messages when debugging
# NODEWATCH_DEBUG=1

# ── Authentication for the remote API (client side) ──────────────────────────
# Option 1: pre-obtained token
# NODEWATCH_TOKEN=your_access_token

# Option 2: auto-login via your own module. The function must return a str;
# a non-str return is rejected rather than sent as a header.
# NODEWATCH_LOGIN_MODULE=your_package.auth
# NODEWATCH_LOGIN_FUNCTION=login
# API_ENDPOINT=https://your-server.com/api/v1/
# AUTH_USERNAME=your_username
# AUTH_PASSWORD=your_password

# ── HTTP API (server side) ───────────────────────────────────────────────────
# If set, every API route requires `Authorization: Bearer <this value>`.
# Unset means no auth check at all — fine behind an already-authenticated app.
# NODEWATCH_API_TOKEN=your_api_secret

# ── A/B benchmarking with the "model" transport ──────────────────────────────
# Only needed for `nodewatch ab-run` against models directly, and only for the
# provider you actually use. Requires the ab-model extra.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# ── NOT a nodewatch variable ─────────────────────────────────────────────────
# NODEWATCH_ENABLED is a *caller-side* convention, not something the library
# reads. Check it in your own code and skip creating a tracker — see
# examples/langgraph_integration.py and docs/env.md.
